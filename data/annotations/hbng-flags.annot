HBNG_is_five_annot:
@0      # cmp w0, #5
@4      # cset w0, eq
X0 <- 0
@8      # ret
END
HBNG_fsel_annot:
@0      # fcmp d0, d1
@4      # csel x0, x0, x1, mi
X0 <- X0 | X1
@8      # ret
END
HBNG_add128_annot:
@0      # adds x0, x2, x0
X0 <- X2 | X0
@4      # adc x1, x3, x1
X1 <- X3 | X1
@8      # ret
END
