HBNG_addp_annot:
@0      # addp v0.4s, v0.4s, v1.4s
V0[0:7] <- V0[0:15] per 8:4
V0[8:15] <- V1[0:15] per 8:4
@4      # ret
END
HBNG_addv_annot:
@0      # addv s0, v0.4s
V0[0:3] <- V0[0:15]
V0[4:15] <- 0
@4      # fmov w0, s0
X0 <- V0[0:3]
@8      # ret
END
HBNG_uaddlv_annot:
@0      # uaddlv h0, v0.16b
V0[0:1] <- V0[0:15]
V0[2:15] <- 0
@4      # fmov w0, s0
X0 <- V0[0:3]
@8      # ret
END
